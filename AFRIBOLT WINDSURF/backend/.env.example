# ===== REQUIRED =====
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://afribolt:your-db-password@localhost:5432/afribolt"

# Authentication - MUST be a strong random string (min 32 chars)
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# CORS - Frontend URL allowed to access API
FRONTEND_URL=http://localhost:3000

# ===== DOCKER COMPOSE =====
# These are used by docker-compose.yml
POSTGRES_DB=afribolt
POSTGRES_USER=afribolt
POSTGRES_PASSWORD=your-db-password
REDIS_PASSWORD=your-redis-password

# ===== LLM API KEYS (at least one required) =====
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ===== OPTIONAL =====
# Redis (for rate limiting in production)
REDIS_URL=redis://:your-redis-password@localhost:6379

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
